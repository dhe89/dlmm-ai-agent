# Copy to .env locally. Never put real secrets in this file or commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Optional public RPC endpoint. Start with a public/free endpoint and respect rate limits.
SOLANA_RPC_URL=

# Optional data-provider key; leave blank until a provider is selected.
DATA_PROVIDER_API_KEY=

# Safety boundary: paper mode only for the initial milestones.
TRADING_MODE=paper
ENABLE_ONCHAIN_EXECUTION=false
